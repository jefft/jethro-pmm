#!/usr/bin/env php
<?php
/**
 * Record a provider's API exchanges against a base URL — the live API or
 * this mock — as a directory of normalised replies, for diffing.
 *
 *   bin/record <provider> <base-url> <out-dir> [--send]
 *
 *   --send  also record the cases that deliver a real SMS (under send/)
 *
 * Credentials come from the environment (see the provider's cases class).
 * Typical use:
 *   bin/record mobilemessage https://api.mobilemessage.com.au recordings/mobilemessage/actual
 *   bin/record mobilemessage http://127.0.0.1:8089/smsmockserver/tests/functional/smsmock/recording-mobilemessage recordings/mobilemessage/mockresults
 *   diff -ru --exclude='*.raw.json' recordings/mobilemessage/actual recordings/mobilemessage/mockresults
 */

declare(strict_types=1);

require __DIR__ . '/../autoload.php';

use SmsMockServer\Recorder\MobileMessageCases;
use SmsMockServer\Recorder\Recorder;

$send = in_array('--send', $argv, true);
$args = array_values(array_diff(array_slice($argv, 1), ['--send']));
if (count($args) !== 3) {
    fwrite(STDERR, "Usage: bin/record <provider> <base-url> <out-dir> [--send]\nProviders: mobilemessage\n");
    exit(2);
}
[$provider, $baseUrl, $outDir] = $args;

try {
    $cases = match ($provider) {
        'mobilemessage' => MobileMessageCases::fromEnv(),
        default => throw new \RuntimeException("Unknown provider '$provider' (known: mobilemessage)"),
    };
    $count = (new Recorder($cases, rtrim($baseUrl, '/'), rtrim($outDir, '/'), $send))->run();
} catch (\RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}
echo "Recorded $count $provider cases in $outDir\n";
