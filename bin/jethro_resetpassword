#!/usr/bin/env php
<?php
# SYNOPSIS: Resets the password of a given staff member of the in-context church. New password is displayed for you to relay to the user.

define('JETHRO_ROOT', $_SERVER["ATL_APPDIR"]."/app");
$_SERVER['HTTP_HOST']=$_SERVER["ATL_FQDN"];
set_include_path(get_include_path().PATH_SEPARATOR.JETHRO_ROOT);
require_once JETHRO_ROOT.'/conf.php';
#define('DB_MODE', 'PRIVATE');
require_once JETHRO_ROOT.'/include/init.php';
require_once JETHRO_ROOT.'/include/user_system.class.php';
require_once JETHRO_ROOT.'/include/system_controller.class.php';
$GLOBALS['user_system'] = new User_System();
$GLOBALS['user_system']->setCLIScript();
$GLOBALS['system'] = System_Controller::get();

if (count($argv) != 2 ) {
	fwrite(STDERR, "Usage: ".$argv[0]." username".PHP_EOL);
	exit(1);
}

$givenusername=$argv[1];
$SQL="select * from staff_member where username = " . $GLOBALS['db']->quote($givenusername).";";
$res = $GLOBALS['db']->queryAll($SQL);
if (count($res) == 1) {

	($givenusername == $res[0]["username"]) or trigger_error("");

} else if (count($res) > 1) {
	fwrite(STDERR, "More than one result".PHP_EOL);
	exit(1);
} else if (count($res) == 0) {
	fwrite(STDERR, "Could not find username: ".$givenusername.PHP_EOL);
	exit(1);
}
$userid=(int)$res[0]['id'];
($userid > 0) or die("Internal error: userid 0");

$password=generate_random_string(10);
$hash=jethro_password_hash($password);

$user = $GLOBALS['system']->getDBObject('staff_member', $userid);

$oldhash = $user->getValue("password");
printf("%-20s %s\n",	"User:",	$user->getValue("username"));
printf("%-20s %s\n",	"Old hash:",	$oldhash);
$user->setValue("password",$hash);
$GLOBALS['JETHRO_INSTALLING'] = 1;
$user->save();
printf("%-20s %s\n",	"New password:",	$password);
