#!/usr/bin/php8.4
<?php
# SYNOPSIS: Reads a password from stdin and prints its Jethro password hash.
define('JETHRO_ROOT', dirname(__DIR__));
require_once JETHRO_ROOT.'/include/general.php';

$password = stream_get_contents(STDIN);
$password = rtrim($password, "\n\r");

if ($password === '') {
	fwrite(STDERR, "Error: password must not be empty\n");
	exit(1);
}

echo jethro_password_hash($password), "\n";
